#lang racket/base
;; Turns a machine value into the .machine format: plain S-expressions
;; with every number a finite flonum, so the C# reader never meets exact
;; rationals (3/100) or infinities.
(require racket/path racket/match "machine.rkt" "geometry/shape.rkt")
(provide machine->sexp write-machine-file)

(define (num who v)
  (unless (and (real? v) (rational? v))
    (error 'machine->sexp "~a must be a finite number, got ~e" who v))
  (exact->inexact v))

(define (value who v)
  (if (or (boolean? v) (symbol? v) (string? v)) v (num who v)))

(define (loc->sexp loc root)
  (define file (vector-ref loc 0))
  (define shown
    (if (and root (absolute-path? file))
        (path->string (find-relative-path (simple-form-path root) (simple-form-path file)))
        file))
  `(srcloc ,shown ,(vector-ref loc 1) ,(vector-ref loc 2)))

(define (part->sexp p root)
  (define id (part-id p))
  `(part ,id ,(part-kind p)
         (material ,(part-material p))
         (at ,@(for/list ([x (part-at p)]) (num (format "~a position" id) x)))
         (props ,@(for*/list ([kv (part-props p)] [item (prop->items id kv)]) item))
         (ports ,@(for/list ([pt (part-ports p)])
                    (list (port-spec-name pt) (port-spec-kind pt)
                          (num (format "~a port height" id) (port-spec-height pt)))))
         ,(loc->sexp (part-loc p) root)))

;; A generated shape becomes the name of its mesh file (build.rkt writes
;; it to game/meshes/<stem>.glb), its material volume, and the numbers
;; that describe it — a gear's pitch radius, a screw's pitch — so the game
;; never has to measure a mesh to learn them.
(define (prop->items id kv)
  (define v (cdr kv))
  (if (shape? v)
      `((shape ,(shape-kind v))
        (mesh ,(shape-file-stem v))
        (volume ,(num (format "~a shape volume" id) (shape-volume v)))
        ,@(for/list ([axis '(inertia-x inertia-y inertia-z)] [i (shape-inertia v)])
            (list axis (num (format "~a shape ~a" id axis) i)))
        ,@(for/list ([sp (shape-props v)])
            (list (car sp) (value (format "~a shape ~a" id (car sp)) (cdr sp)))))
      (list (list (car kv) (value (format "~a #:~a" id (car kv)) v)))))

;; root: when given, source paths are written relative to it.
(define (machine->sexp m #:root [root #f])
  `(machine ,(machine-name m)
            ,@(if (machine-source m) `((source ,(machine-source m))) '())
            ,@(if (= (machine-ambient m) 20) '() `((ambient ,(num "#:ambient" (machine-ambient m)))))
            ,@(match (machine-sun m)
                [#f '()]
                [(list lat day time) `((sun (latitude ,(num "#:latitude" lat)) (day ,day) (time ,(num "#:time" time))))])
            ,@(for/list ([p (machine-parts m)]) (part->sexp p root))
            ,@(for/list ([p (machine-pipes m)])
                `(pipe ,(pipe-spec-id p)
                       (from ,@(pipe-spec-from p))
                       (to ,@(pipe-spec-to p))
                       (conductance ,(num (format "pipe ~a conductance" (pipe-spec-id p))
                                          (pipe-spec-conductance p)))
                       (jet ,(pipe-spec-jet? p))
                       ,(loc->sexp (pipe-spec-loc p) root)))
            ,@(for/list ([c (machine-connects m)])
                `(connect ,(connect-spec-from c) ,(connect-spec-to c)
                          ,(loc->sexp (connect-spec-loc c) root)))
            ,@(for/list ([r (machine-ropes m)])
                (define id (rope-spec-id r))
                (define (end e) (cons (car e) (for/list ([x (cdr e)]) (num (format "rope ~a end" id) x))))
                `(rope ,id
                       (from ,@(end (rope-spec-from r)))
                       (to ,@(end (rope-spec-to r)))
                       (length ,(num (format "rope ~a #:length" id) (rope-spec-length r)))
                       (over ,@(for/list ([p (rope-spec-over r)])
                                 (for/list ([x p]) (num (format "rope ~a #:over" id) x))))
                       (wind-on ,(rope-spec-wind-on r))
                       (release-deg ,(let ([d (rope-spec-release-deg r)]) (if d (num "rope #:release-deg" d) #f)))
                       (material ,(rope-spec-material r))
                       (diameter ,(num (format "rope ~a #:diameter" id) (rope-spec-diameter r)))
                       (nocked ,(rope-spec-nocked r))
                       (turns ,(rope-spec-turns r))
                       (bar ,(rope-spec-bar r))
                       (mu ,(let ([u (rope-spec-mu r)]) (if u (num (format "rope ~a #:mu" id) u) #f)))
                       ,(loc->sexp (rope-spec-loc r) root)))
            ,@(for/list ([i (machine-inflows m)])
                `(inflow ,(inflow-spec-id i) (into ,(inflow-spec-into i))
                         (flow ,(num "inflow #:flow" (inflow-spec-flow i)))
                         ,(loc->sexp (inflow-spec-loc i) root)))
            ,@(for/list ([c (machine-channels m)])
                (define id (channel-spec-id c))
                `(channel ,id (from ,@(channel-spec-from c))
                          (to ,@(let ([t (channel-spec-to c)]) (if (eq? t 'off) '(off) t)))
                          (end ,@(let ([e (channel-spec-end c)]) (if e (for/list ([x e]) (num "channel #:end" x)) '())))
                          (via ,@(for/list ([p (channel-spec-via c)]) (for/list ([x p]) (num "channel #:via" x))))
                          (width ,(num (format "channel ~a #:width" id) (channel-spec-width c)))
                          (length ,(let ([l (channel-spec-length c)]) (if l (num "channel #:length" l) #f)))
                          (onto ,(channel-spec-onto c))
                          ,(loc->sexp (channel-spec-loc c) root)))
            ,@(for/list ([t (machine-triggers m)])
                (define id (trigger-spec-id t))
                (define (nums what l) (if l (for/list ([x l]) (num (format "trigger ~a ~a" id what) x)) '()))
                `(trigger ,id (at ,@(nums "#:at" (trigger-spec-at t))) (size ,@(nums "#:size" (trigger-spec-size t)))
                          (body ,(trigger-spec-body t))
                          (when ,@(let ([w (trigger-spec-when t)])
                                    (if w (list (car w) (cadr w) (caddr w) (num (format "trigger ~a #:when" id) (cadddr w))) '())))
                          (do ,@(for/list ([a (trigger-spec-actions t)])
                                  (list (car a) (cadr a) (num (format "trigger ~a #:do" id) (caddr a)))))
                          ,(loc->sexp (trigger-spec-loc t) root)))
            ,@(for/list ([c (machine-cylinders m)])
                `(atmospheric-cylinder ,(cylinder-spec-id c) (piston ,(cylinder-spec-piston c))
                                       (steam-from ,(cylinder-spec-boiler c))
                                       ,@(if (cylinder-spec-injection-temperature c)
                                             `((injection-temperature ,(num "cylinder #:injection-temperature" (cylinder-spec-injection-temperature c))))
                                             '())
                                       ,(loc->sexp (cylinder-spec-loc c) root)))
            ,@(for/list ([l (machine-lifts m)])
                `(lift ,(lift-spec-id l) (by ,(lift-spec-by l)) (from ,(lift-spec-from l)) (to ,(lift-spec-to l))
                       (current ,(let ([c (lift-spec-current l)]) (if c (num "lift #:current" c) #f)))
                       (current-from ,(lift-spec-current-from l))
                       ,(loc->sexp (lift-spec-loc l) root)))
            ,@(for/list ([g (machine-meshes m)])
                `(mesh ,(mesh-spec-a g) ,(mesh-spec-b g) ,(loc->sexp (mesh-spec-loc g) root)))
            ,@(for/list ([a (machine-arbors m)])
                `(arbor (parts ,@(arbor-spec-parts a)) ,(loc->sexp (arbor-spec-loc a) root)))
            ,@(for/list ([a (machine-airs m)])
                `(sealed-air (tanks ,@(air-spec-tanks a))
                             (tube-volume ,(num "sealed-air #:tube" (air-spec-tube-volume a)))
                             (heat-loss ,(num "sealed-air #:heat-loss" (air-spec-heat-loss a)))
                             (heat-capacity ,(num "sealed-air #:heat-capacity" (air-spec-heat-capacity a)))
                             ,(loc->sexp (air-spec-loc a) root)))))

(define (write-machine-file m path #:root [root #f] #:from [from #f])
  (call-with-output-file path #:exists 'truncate/replace
    (λ (out)
      (fprintf out ";; Generated by #lang heroic~a. Do not edit: change the Racket source and rebuild.\n"
               (if from (format " from ~a" from) ""))
      ;; One clause per line keeps the files readable and their diffs small.
      (define sexp (machine->sexp m #:root root))
      (fprintf out "(machine ~s" (cadr sexp))
      (for ([clause (cddr sexp)])
        (fprintf out "\n  ~s" clause))
      (fprintf out ")\n"))))
