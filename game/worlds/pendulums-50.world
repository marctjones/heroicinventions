;; Fifty copies of the pendulum demo in one world, 1.5 m apart: issue #74's
;; check that machines sharing a world don't disturb one another.
(world pendulums-50
  (place p0 pendulum-demo (at 0.0 0 0.0))
  (place p1 pendulum-demo (at 1.5 0 0.0))
  (place p2 pendulum-demo (at 3.0 0 0.0))
  (place p3 pendulum-demo (at 4.5 0 0.0))
  (place p4 pendulum-demo (at 6.0 0 0.0))
  (place p5 pendulum-demo (at 7.5 0 0.0))
  (place p6 pendulum-demo (at 9.0 0 0.0))
  (place p7 pendulum-demo (at 10.5 0 0.0))
  (place p8 pendulum-demo (at 12.0 0 0.0))
  (place p9 pendulum-demo (at 13.5 0 0.0))
  (place p10 pendulum-demo (at 0.0 0 1.5))
  (place p11 pendulum-demo (at 1.5 0 1.5))
  (place p12 pendulum-demo (at 3.0 0 1.5))
  (place p13 pendulum-demo (at 4.5 0 1.5))
  (place p14 pendulum-demo (at 6.0 0 1.5))
  (place p15 pendulum-demo (at 7.5 0 1.5))
  (place p16 pendulum-demo (at 9.0 0 1.5))
  (place p17 pendulum-demo (at 10.5 0 1.5))
  (place p18 pendulum-demo (at 12.0 0 1.5))
  (place p19 pendulum-demo (at 13.5 0 1.5))
  (place p20 pendulum-demo (at 0.0 0 3.0))
  (place p21 pendulum-demo (at 1.5 0 3.0))
  (place p22 pendulum-demo (at 3.0 0 3.0))
  (place p23 pendulum-demo (at 4.5 0 3.0))
  (place p24 pendulum-demo (at 6.0 0 3.0))
  (place p25 pendulum-demo (at 7.5 0 3.0))
  (place p26 pendulum-demo (at 9.0 0 3.0))
  (place p27 pendulum-demo (at 10.5 0 3.0))
  (place p28 pendulum-demo (at 12.0 0 3.0))
  (place p29 pendulum-demo (at 13.5 0 3.0))
  (place p30 pendulum-demo (at 0.0 0 4.5))
  (place p31 pendulum-demo (at 1.5 0 4.5))
  (place p32 pendulum-demo (at 3.0 0 4.5))
  (place p33 pendulum-demo (at 4.5 0 4.5))
  (place p34 pendulum-demo (at 6.0 0 4.5))
  (place p35 pendulum-demo (at 7.5 0 4.5))
  (place p36 pendulum-demo (at 9.0 0 4.5))
  (place p37 pendulum-demo (at 10.5 0 4.5))
  (place p38 pendulum-demo (at 12.0 0 4.5))
  (place p39 pendulum-demo (at 13.5 0 4.5))
  (place p40 pendulum-demo (at 0.0 0 6.0))
  (place p41 pendulum-demo (at 1.5 0 6.0))
  (place p42 pendulum-demo (at 3.0 0 6.0))
  (place p43 pendulum-demo (at 4.5 0 6.0))
  (place p44 pendulum-demo (at 6.0 0 6.0))
  (place p45 pendulum-demo (at 7.5 0 6.0))
  (place p46 pendulum-demo (at 9.0 0 6.0))
  (place p47 pendulum-demo (at 10.5 0 6.0))
  (place p48 pendulum-demo (at 12.0 0 6.0))
  (place p49 pendulum-demo (at 13.5 0 6.0))
)
