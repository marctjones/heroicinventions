<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A Godot-free console host for HeroicInventions.Sim: loads a .machine
    file, steps its solvers, and streams sampled telemetry back over
    stdin/stdout as S-expressions. Racket's racket/heroic/simhost.rkt is
    the client; this is what makes machine behaviour testable from
    rackunit without launching Godot. See docs/design.html §III
    "Machines as tests".
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- net10.0 to match the runtime actually installed in dev/CI (see
         tests/HeroicInventions.Sim.Tests, which targets the same); the
         referenced Sim library itself still targets net8.0. -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../HeroicInventions.Sim/HeroicInventions.Sim.csproj" />
  </ItemGroup>

</Project>
